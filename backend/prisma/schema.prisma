generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  ADMIN
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STAFF)
  inquiries    Inquiry[]
  createdAt    DateTime  @default(now())
}

model Inquiry {
  id              String        @id @default(uuid())
  customerName    String
  customerContact String
  subject         String
  description     String
  status          InquiryStatus @default(NEW)
  version         Int           @default(1)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([createdById])
  @@index([status])
}
